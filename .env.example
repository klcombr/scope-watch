# Scopewise — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.

# URL do banco de dados
# SQLite para desenvolvimento:
DATABASE_URL=sqlite:///./scopewise.db
# PostgreSQL para produção (exemplo com Neon, Supabase, Render):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Chave secreta para JWT — MUDE para um valor longo e aleatório em produção
# O app recusa iniciar em produção com o valor padrão.
SECRET_KEY=change-me-to-a-long-random-string

# Ambiente: development | production
APP_ENV=development

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Valor/hora padrão para novos projetos
DEFAULT_HOURLY_RATE=100.0

# CORS — origens permitidas (separadas por vírgula)
# Incluir a URL do GitHub Pages: https://SEU-USERNAME.github.io
# CORS_ORIGINS=https://seu-username.github.io,https://scopewise.app

# Frontend — URL da API backend (vazio em dev via proxy, URL completa em produção)
# VITE_API_URL=https://seu-backend.onrender.com
